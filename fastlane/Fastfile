default_platform(:ios)

platform :ios do
  lane :submit do
    deliver(
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      app_identifier: "com.coldtank.cards",
      app_version: "1.0",
      api_key_path: "./api_key.json",
      team_id: ENV["TEAM_ID"]
    )
  end

  # 仅上传 metadata + 图标到 App Store Connect 后台，不提交审核、不上传二进制
  # ⚠️ 图标是 App-level asset，跟 IPA build 是两条独立链路——IPA 上传不会更新 App Icon。
  #    每次想换 logo 都必须跑这个 lane（手动 trigger workflow_dispatch）。
  lane :upload_metadata do
    deliver(
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      overwrite_screenshots: true,
      # 显式指定图标路径——避免 deliver 因 zh-Hans 子目录有同名校验文件而漏传
      app_icon: "./fastlane/metadata/app_icon.png",
      # 跳过 precheck：API Key 模式 + 首版 App 触发的 verify 链路会崩，
      # 但 metadata + icon 上传跟 precheck 是独立两步，跳过 precheck 不影响实际写入
      skip_precheck: true,
      # 详细日志，CI 里能看见 deliver 每一步在干什么
      verbose: true,
      app_identifier: "com.coldtank.cards",
      app_version: "1.0",
      api_key_path: "./api_key.json",
      team_id: ENV["TEAM_ID"]
    )
  end

  # 上传 IPA 到 TestFlight（pilot 走 Transporter 验证过的路径）
  #
  # ⚠️ lane 名绝不能叫 upload_to_testflight —— 与 fastlane 内置 action 同名时，
  #    lane 体内的 upload_to_testflight(...) 会被解析成 lane 自己 → 无限自我递归
  #    → SystemStackError（报错栈顶显示在 tty-screen，极易误判为环境问题）。
  lane :beta do
    upload_to_testflight(
      ipa: "build/export/App.ipa",
      app_identifier: "com.coldtank.cards",
      api_key_path: "./api_key.json",
      # 只上传 + 等 Apple 处理完成确认 Build 建出来，不分发给测试员（还没配 tester）
      skip_submission: true,
      skip_waiting_for_build_processing: false
    )
  end
end
