default_platform(:ios)

platform :ios do
  lane :submit do
    deliver(
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      app_identifier: "com.coldtank.cards",
      app_version: "1.0",
      api_key_path: "./api_key.json",
      team_id: ENV["TEAM_ID"]
    )
  end

  # 仅上传 metadata + 图标到 App Store Connect 后台，不提交审核、不上传二进制
  lane :upload_metadata do
    deliver(
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      app_identifier: "com.coldtank.cards",
      app_version: "1.0",
      api_key_path: "./api_key.json",
      team_id: ENV["TEAM_ID"]
    )
  end

  # 上传 IPA 到 TestFlight（pilot 走 Transporter 验证过的路径）
  #
  # ⚠️ lane 名绝不能叫 upload_to_testflight —— 与 fastlane 内置 action 同名时，
  #    lane 体内的 upload_to_testflight(...) 会被解析成 lane 自己 → 无限自我递归
  #    → SystemStackError（报错栈顶显示在 tty-screen，极易误判为环境问题）。
  lane :beta do
    upload_to_testflight(
      ipa: "build/export/App.ipa",
      app_identifier: "com.coldtank.cards",
      api_key_path: "./api_key.json",
      # 只上传 + 等 Apple 处理完成确认 Build 建出来，不分发给测试员（还没配 tester）
      skip_submission: true,
      skip_waiting_for_build_processing: false
    )
  end
end
